{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻账",
  "version": "0.1.1",
  "identifier": "com.yakit.lightledger",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻账",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "../../shared/app/icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
