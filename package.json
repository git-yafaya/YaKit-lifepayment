{
  "name": "lightledger",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "npm --prefix Windows run tauri --",
    "android:dev": "bash Android/scripts/android.sh dev",
    "android:build": "bash Android/scripts/android.sh build --debug --apk --target aarch64",
    "tauri:windows": "npm --prefix Windows run tauri --",
    "tauri:android": "npm --prefix Android run tauri --"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
